rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Shop settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Services catalog
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Barbers profiles
    match /barbers/{barberId} {
      allow read: if true;
      allow write: if true;
    }

    // Barber schedules
    match /barber_schedules/{scheduleId} {
      allow read: if true;
      allow write: if true;
    }

    // Barber time off
    match /barber_time_off/{timeOffId} {
      allow read: if true;
      allow write: if true;
    }

    // Appointments (Customer bookings)
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if request.resource.data.customer_name is string
                    && request.resource.data.customer_phone is string
                    && request.resource.data.date is string
                    && request.resource.data.start_time is string;
      allow update, delete: if true;
    }

    // Users and Staff accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
