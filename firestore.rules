rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return (isSignedIn() && request.auth.token.email.lower() == 'rs3043017@gmail.com')
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner');
    }

    function isAdmin() {
      return isOwner() || (
        isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function isBarber() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barber';
    }

    function isOwnerConfigured() {
      return exists(/databases/$(database)/documents/settings/main)
        && get(/databases/$(database)/documents/settings/main).data.get('owner_configured', false) == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Shop settings: Public read, write only for admin/owner (or initial owner bootstrap)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin()
        || (isSignedIn() && !isOwnerConfigured() && settingId == 'main');
    }

    // Services catalog: Public read, write only for admin/owner
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    // Barbers profiles: Public read, write only for admin/owner
    match /barbers/{barberId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }

    // Barber schedules: Public read, write for admin/owner or the assigned barber
    match /barber_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin()
        || (isSignedIn() && isBarber() && resource != null && resource.data.barber_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barber_id);
    }

    // Barber time off: Public read, write for admin/owner or the assigned barber
    match /barber_time_off/{timeOffId} {
      allow read: if true;
      allow write: if isOwnerOrAdmin()
        || (isSignedIn() && isBarber() && (
             (resource != null && resource.data.barber_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barber_id)
             || (request.resource != null && request.resource.data.barber_id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barber_id)
           ));
    }

    // Appointments (Customer bookings): Public read and create, update/delete only for authenticated staff
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if request.resource.data.customer_name is string
                    && request.resource.data.customer_name.size() > 0
                    && request.resource.data.customer_phone is string
                    && request.resource.data.customer_phone.size() > 0
                    && request.resource.data.date is string
                    && request.resource.data.start_time is string;
      allow update, delete: if isSignedIn();
    }

    // Users and Staff accounts (STRICT SECURITY - NO PUBLIC ACCESS)
    // Signed-in staff can read user accounts; modifications strictly limited to owner/admin or self
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isOwnerOrAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isOwnerOrAdmin());
      allow delete: if isOwnerOrAdmin();
    }
  }
}
