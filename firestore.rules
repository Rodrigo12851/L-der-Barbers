rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return (isSignedIn() && request.auth.token.email.lower() == 'rs3043017@gmail.com')
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner');
    }

    function isAdmin() {
      return isOwner() || (
        isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function isBarber() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barber';
    }

    function isOwnerConfigured() {
      return exists(/databases/$(database)/documents/settings/main)
        && get(/databases/$(database)/documents/settings/main).data.get('owner_configured', false) == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Shop settings: Public read and write to ensure seamless updates and seeding across devices
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Services catalog: Public read and write for catalog management
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Barbers profiles: Public read and write for team management
    match /barbers/{barberId} {
      allow read, write: if true;
    }

    // Barber schedules: Public read and write for schedule management
    match /barber_schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Barber time off: Public read and write for pauses and day offs
    match /barber_time_off/{timeOffId} {
      allow read, write: if true;
    }

    // Appointments (Customer bookings & management): Public read and write
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Users and Staff accounts: Public read and write for portal authentication and account management
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
